@{
    ViewBag.Title = "Home";
}

<div class="max-w-6xl mx-auto mt-6 px-4">
    <h2 class="text-2xl font-bold text-center mb-6">My Dashboard Overview</h2>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-blue-600 text-white rounded-2xl shadow-lg p-6 text-center">
            <h4 class="text-lg font-semibold">Total Users</h4>
            <h2 class="text-3xl font-bold mt-2">@ViewBag.TotalUsers</h2>
        </div>
        <div class="bg-green-600 text-white rounded-2xl shadow-lg p-6 text-center">
            <h4 class="text-lg font-semibold">Total Chats</h4>
            <h2 class="text-3xl font-bold mt-2">@ViewBag.TotalChats</h2>
        </div>
    </div>

    <!-- Chart Section -->
    <div class="mt-10 bg-white rounded-2xl shadow-lg p-6">
        <h3 class="text-xl font-semibold mb-4 text-center">Chats Activity</h3>
        <canvas id="chatChart" class="w-full h-64"></canvas>
    </div>
</div>

<script>
    const ctx = document.getElementById('chatChart').getContext('2d');
    new Chart(ctx, {
        type: 'line', // can be 'bar', 'pie', etc.
        data: {
            labels: ["Jan", "Feb", "Mar", "Apr", "May"], 
            datasets: [{
                label: 'Chats',
                data: [5, 10, 7, 15, 20],
                borderColor: '#2563eb',
                backgroundColor: 'rgba(37, 99, 235, 0.3)',
                borderWidth: 2,
                tension: 0.4,
                fill: true
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: true },
            },
            scales: {
                y: { beginAtZero: true }
            }
        }
    });
</script>