<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - My App</title>
    <!-- Tailwind -->
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <!--Font-->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" />
    <!--jQuery-->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Toastr CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <!-- Toastr JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <!--Chart-->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .sidebar-link {
            transition: all 0.3s ease;
        }

            .sidebar-link:hover {
                transform: translateX(4px);
            }

        .active-link {
            background: linear-gradient(135deg, #374151, #111827);
            color: white;
            box-shadow: 0 4px 12px rgba(75, 85, 99, 0.3);
        }

        .glass-effect {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .chat-session {
            cursor: pointer;
            padding: 8px 12px;
            margin: 4px 0;
            border-radius: 8px;
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            transition: all 0.2s ease;
        }

            .chat-session:hover {
                background: #e9ecef;
                transform: translateX(2px);
            }

            .chat-session.active {
                background: #007bff;
                color: white;
            }

        .chat-preview {
            font-size: 0.875rem;
            color: #6c757d;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 200px;
        }

        .chat-session.active .chat-preview {
            color: rgba(255, 255, 255, 0.8);
        }

        .new-chat-btn {
            background: linear-gradient(135deg, #007bff, #0056b3);
            color: white;
            border: none;
            padding: 10px 16px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            width: 100%;
            margin-bottom: 16px;
        }

            .new-chat-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(0, 123, 255, 0.3);
            }
    </style>
</head>
<body class="bg-gradient-to-br from-gray-100 to-gray-200 flex flex-col min-h-screen">
    <header class="bg-gradient-to-br from-gray-800 to-black text-white p-4 shadow-lg">
        <div class="flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <div class="bg-white bg-opacity-20 p-2 rounded-lg">
                    <i class="fas fa-message text-2xl"></i>
                </div>
                <h1 class="text-2xl font-bold tracking-wide">Chat Dashboard</h1>
            </div>
            <nav>
                <ul class="flex space-x-4">
                    @if (Session["userName"] != null)
                    {
                        <div class="flex items-center space-x-3 glass-effect px-4 py-2 rounded-full">
                            <i class="fas fa-user-circle text-lg"></i>
                            <span class="text-lg font-medium">Welcome, @Session["userName"]</span>
                        </div>
                    }
                </ul>
            </nav>
        </div>
    </header>

    <div class="flex flex-1">
        <aside class="w-72 bg-white shadow-lg p-6 border-r border-gray-300">
            <div class="mb-8">
                @if (Session["userRoleName"] != null)
                {
                    <h2 class="text-lg font-semibold text-gray-800 mb-4 ml-1">@Session["userRoleName"], @Session["userName"]</h2>
                }
            </div>
            <ul class="space-y-3">
                @if (Session["userModules"] != null)
                {
                    var modules = Session["userModules"] as List<ChatApplication.Models.Module>;
                    if (modules != null)
                    {
                        foreach (var module in modules)
                        {
                            <li>
                                <a href="@module.href"
                                   class="sidebar-link flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-700
                          hover:bg-gray-100 hover:text-gray-900 font-medium transition-all duration-300">
                                    <i class="@module.module_icon"></i>
                                    <span>@module.module_name</span>
                                </a>
                            </li>
                        }
                    }
                }
                @if (Session["userRoleName"] != null && Session["userRoleName"].ToString().Equals("Admin", StringComparison.OrdinalIgnoreCase))
                {
                    <li class="relative">
                        <button class="settings-toggle flex justify-between items-center w-full px-4 py-3 rounded-xl text-gray-700 hover:bg-gray-100 hover:text-gray-900 font-medium transition-all duration-300">
                            <span class="flex items-center space-x-3">
                                <i class="fa-solid fa-gear"></i>
                                <span>Settings</span>
                            </span>
                            <i class="fa-solid fa-chevron-down transition-transform duration-200"></i>
                        </button>
                        <ul class="settings-menu hidden pl-10 mt-2 space-y-3">
                            <li>
                                <a href="@Url.Action("User", "User")"
                                   class="sidebar-link flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-700 hover:bg-gray-100 hover:text-gray-900 font-medium transition-all duration-300">
                                    <i class="fa-solid fa-users"></i>
                                    <span>User</span>
                                </a>
                            </li>
                            <li>
                                <a href="@Url.Action("Role", "Role")"
                                   class="sidebar-link flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-700 hover:bg-gray-100 hover:text-gray-900 font-medium transition-all duration-300">
                                    <i class="fa-solid fa-user-shield"></i>
                                    <span>Role</span>
                                </a>
                            </li>
                            <li>
                                <a href="@Url.Action("Module", "Module")"
                                   class="sidebar-link flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-700 hover:bg-gray-100 hover:text-gray-900 font-medium transition-all duration-300">
                                    <i class="fa-solid fa-cubes"></i>
                                    <span>Module</span>
                                </a>
                            </li>
                            <li>
                                <a href="@Url.Action("Permission", "Permission")"
                                   class="sidebar-link flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-700 hover:bg-gray-100 hover:text-gray-900 font-medium transition-all duration-300">
                                    <i class="fa-solid fa-lock"></i>
                                    <span>Permission</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                }

                <!-- Chat Sessions Section -->
                <li class="pt-4 border-t border-gray-300 mt-6">
                    <div class="text-gray-600 mb-3">
                        <div class="flex justify-between items-center">
                            <h5 class="font-semibold">Chats</h5>
                            <button onclick="startNewChat()" class="text-blue-600 hover:text-blue-800" title="New Chat">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                    </div>
                    <button onclick="startNewChat()" class="new-chat-btn">
                        <i class="fas fa-plus mr-2"></i>
                        New Chat
                    </button>
                    <div class="max-h-64 overflow-y-auto">
                        <ul id="chatSessions"></ul>
                    </div>
                </li>

                <li class="pt-4 border-t border-gray-300 mt-6">
                    <a href="@Url.Action("Logout", "User")"
                       class="sidebar-link flex items-center space-x-3 px-4 py-3 rounded-xl text-red-600 hover:bg-red-50 hover:text-red-700 font-medium transition-all duration-300">
                        <i class="fa fa-sign-out"></i>
                        <span>Logout</span>
                    </a>
                </li>
            </ul>
        </aside>

        <main class="flex-1 p-8 bg-gray-100">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-gradient-to-r from-gray-800 to-black text-white text-center p-6 shadow-md">
        <div class="flex justify-center items-center space-x-2">
            <i class="fas fa-copyright"></i>
            <p class="font-medium">@DateTime.Now.Year - My App. All rights reserved.</p>
        </div>
    </footer>

    <script>
        $(".settings-toggle").click(function () {
            $(".settings-menu").slideToggle(200);
            $(this).find("i.fa-chevron-down, i.fa-chevron-up").toggleClass("fa-chevron-down fa-chevron-up");
        });

        let currentSessionId = null;

        async function loadChats() {
            try {
                const res = await fetch("/Chat/GetUserChats");
                const chats = await res.json();
                let list = "";

                // Get current session ID from URL if on chat page
                const urlParams = new URLSearchParams(window.location.search);
                const urlSessionId = urlParams.get('sessionId');

                chats.forEach(c => {
                    const isActive = urlSessionId === c.SessionId ? 'active' : '';
                    const truncatedMessage = c.LastMessage.length > 30
                        ? c.LastMessage.substring(0, 30) + '...'
                        : c.LastMessage;

                    list += `
                        <li class="chat-session ${isActive}" onclick="loadSession('${c.SessionId}')">
                            <div class="font-medium text-sm">${escapeHtml(truncatedMessage)}</div>
                        </li>`;
                });

                document.getElementById("chatSessions").innerHTML = list;
            } catch (error) {
                console.error('Error loading chats:', error);
            }
        }

        function loadSession(sessionId) {
            // Remove active class from all sessions
            document.querySelectorAll('.chat-session').forEach(session => {
                session.classList.remove('active');
            });

            // Add active class to clicked session
            event.target.closest('.chat-session').classList.add('active');

            // Navigate to chat page with session ID
            window.location.href = `/Chat/Chat?sessionId=${sessionId}`;
        }

        function startNewChat() {
            // Remove active class from all sessions
            document.querySelectorAll('.chat-session').forEach(session => {
                session.classList.remove('active');
            });

            // Navigate to new chat
            window.location.href = '/Chat/Chat';
        }

        function formatDate(dateString) {
            const date = new Date(dateString);
            const now = new Date();
            const diff = now - date;
            const days = Math.floor(diff / (1000 * 60 * 60 * 24));

            if (days === 0) return 'Today';
            if (days === 1) return 'Yesterday';
            if (days < 7) return `${days} days ago`;

            return date.toLocaleDateString();
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Load chats when page loads
        loadChats();

        $(document).ready(function () {
            var currentPath = window.location.pathname;
            $('.sidebar-link').each(function() {
                if ($(this).attr('href') === currentPath) {
                    $(this).addClass('active-link');
                }
            });

            document.addEventListener('DOMContentLoaded', function () {
                const settingsToggle = document.querySelector('.settings-toggle');
                const settingsMenu = document.querySelector('.settings-menu');
                const chevronIcon = settingsToggle?.querySelector('.fa-chevron-down');

                if (settingsToggle && settingsMenu) {
                    settingsToggle.addEventListener('click', function () {
                        settingsMenu.classList.toggle('hidden');
                        if (chevronIcon) {
                            chevronIcon.classList.toggle('rotate-180');
                        }
                    });
                }
            });

            @if (TempData["ToastrMessage"] != null)
            {
                <text>
                    toastr.options = {
                        "closeButton": true,
                        "progressBar": true,
                        "positionClass": "toast-top-right",
                        "timeOut": "3000",
                        "extendedTimeOut": "1000",
                        "showEasing": "swing",
                        "hideEasing": "linear",
                        "showMethod": "fadeIn",
                        "hideMethod": "fadeOut"
                    };
                    toastr["@TempData["ToastrType"]"]("@TempData["ToastrMessage"]");
                </text>
            }
        });
    </script>
</body>
</html>